# Corner Room production settings (deploy readiness, 2026-10-23).
# Copy to .env.production in the repo root on the SERVER, fill it in, then: chmod 600 .env.production
# Never commit the filled copy (it is in .gitignore). Every "CHANGE_ME" must be replaced.
# Lines marked OWNER DECISION stay empty or 0 until the product owner decides (CLAUDE.md rule 3).

# --- Database (used by deploy/compose.prod.yml to create Postgres and build DATABASE_URL) ---
POSTGRES_USER=cornerroom
POSTGRES_PASSWORD=CHANGE_ME_long_random
POSTGRES_DB=cornerroom

# --- App ---
APP_ENV=production
APP_NAME=Corner Room
LOG_LEVEL=INFO
# Release label shown in image names; deploy.sh sets it to the git commit.
RELEASE=latest

# --- Secrets: three DIFFERENT long random values (openssl rand -hex 48). Production refuses defaults. ---
JWT_SECRET=CHANGE_ME
TICKET_SIGNING_SECRET=CHANGE_ME
MEDIA_TOKEN_SECRET=CHANGE_ME
JWT_ISSUER=cornerroom
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# --- One address for site and API: nginx sends /api/ to the API, everything else to the web app ---
WEB_BASE_URL=https://www.cornerroom.live
CORS_ORIGINS=https://www.cornerroom.live,https://cornerroom.live
# Host names the API answers to. 127.0.0.1 and localhost are for the container health check.
ALLOWED_HOSTS=www.cornerroom.live,cornerroom.live,127.0.0.1,localhost
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
HSTS_MAX_AGE_SECONDS=31536000
# nginx reaches the containers through Docker's network: trust X-Forwarded-For from there only.
FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12
# Leave empty: the site calls the API on its own address.
NEXT_PUBLIC_API_URL=

# --- Capacity (compose defaults shown) ---
WEB_CONCURRENCY=3
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4

# --- Storage: on the server's disk (docker volume "storage"); backed up to R2 by deploy/scripts/backup.sh ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/var/storage
# OWNER DECISION (Q-P0-12): the data region. Audio masters cannot be stored in production until set.
RESIDENCY_REGION=

# --- First admin, created on first start only. Use a real mailbox; change the password after first sign-in. ---
BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME@cornerroom.live
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_long_random

# --- Email (OD-08: Brevo chosen 2026-10-22). Brevo > SMTP & API > SMTP gives the login and key. ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
# A sender on a domain verified in Brevo (SPF/DKIM records added in Cloudflare DNS).
EMAIL_FROM=Corner Room <no-reply@cornerroom.live>

# --- Link lifetimes: OWNER DECISION. 0 = the feature is off (sign-up verification and password reset
# then do not work; invitations never expire). Set them once the owner picks the numbers. ---
VERIFICATION_CHALLENGE_TTL_SECONDS=0
PASSWORD_RECOVERY_TTL_SECONDS=0
ORGANIZATION_INVITATION_TTL_SECONDS=0

# --- Rate limits: OWNER DECISION (Q-P14-07). 0 = off. ---
AUTH_RATE_LIMIT_MAX_ATTEMPTS=0
AUTH_RATE_LIMIT_WINDOW_SECONDS=0

# --- Payments: OWNER DECISION. "sandbox" takes no real payments in production (orders can never be
# paid); "bangla_qr" = buyers pay by Bangla QR and finance staff confirm. ---
PAYMENT_PROVIDER=sandbox
BANGLA_QR_IMAGE_URL=/brand/payment/bangla-qr.png
BANGLA_QR_MERCHANT_NAME=
BANGLA_QR_MERCHANT_NUMBER=
BANGLA_QR_NUMBER_APP=

# --- Google sign-in (optional): needs the owner's Google Cloud OAuth client. Empty = off. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.cornerroom.live/api/v1/auth/google/callback

# --- Outbox and idempotency (technical defaults) ---
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BACKOFF_SECONDS=15
IDEMPOTENCY_TTL_SECONDS=86400
REDIS_KEY_PREFIX=cr

# --- Backups to Cloudflare R2 (deploy/scripts/backup.sh, via rclone) ---
# rclone remote and bucket, e.g. r2:<bucket-name>
R2_REMOTE=
BACKUP_KEEP_DAYS=14
