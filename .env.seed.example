# Local demo accounts for the dev stack. Copy to .env.seed.local (gitignored) and fill in your own
# values. Used by `.\scripts\dev-stack.ps1 -Seed` (apps/api/scripts/dev_seed.py). Local only: never
# reuse these anywhere else, and never put real people's data here.
#
# Emails must not use a .test domain (the email validator rejects it); example.com works.

# The super admin created on first start (staff console: /staff/sign-in)
BOOTSTRAP_ADMIN_EMAIL=admin.demo@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Demo staff (ops.demo@example.com) and demo fan (fan.demo@example.com) passwords
DEMO_STAFF_PASSWORD=
DEMO_FAN_PASSWORD=

# Sandbox payment webhook secret (any long random string, must differ from JWT_SECRET)
SANDBOX_PAYMENT_SECRET=

# Local only, not a policy decision: lets sign-up verification links work on this machine (seconds)
VERIFICATION_CHALLENGE_TTL_SECONDS=86400
