# Copy to .env and fill in. Never commit .env.

APP_ENV=local
APP_NAME=cornerroom
LOG_LEVEL=INFO

# Async SQLAlchemy URL (api + tests)
DATABASE_URL=postgresql+asyncpg://cornerroom:cornerroom@localhost:5432/cornerroom
# Sync URL for Alembic
DATABASE_URL_SYNC=postgresql+psycopg://cornerroom:cornerroom@localhost:5432/cornerroom

REDIS_URL=redis://localhost:6379/0

# JWT — generate a long random value for anything beyond local toys
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=cornerroom
# Separate signing keys for ticket QR codes and playback/download links. Leave empty locally (they
# fall back to JWT_SECRET); production refuses to start unless both are set, long and all different.
TICKET_SIGNING_SECRET=
MEDIA_TOKEN_SECRET=

# Cookie (httpOnly refresh). Secure=false for local HTTP. SAMESITE: lax | strict | none (none needs
# COOKIE_SECURE=true; only for a web app and API on different sites).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# CORS — Next.js local origin
CORS_ORIGINS=http://localhost:3000

# API host names (blocks forged Host headers). * locally; production must list the real host(s).
ALLOWED_HOSTS=*
# Proxy addresses allowed to set X-Forwarded-For/-Proto (real client IP). Empty = ignore them.
# On Railway (reachable only through its proxy) use *.
FORWARDED_ALLOW_IPS=
# HSTS max-age in seconds, sent only when COOKIE_SECURE=true. 0 = off.
HSTS_MAX_AGE_SECONDS=31536000

# Object storage: local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# Q-P0-12 residency gate. Empty = production masters/ID docs rejected.
RESIDENCY_REGION=

# Optional first admin (local/dev only). Leave empty to skip.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Outbox / idempotency (infrastructure)
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BACKOFF_SECONDS=15
IDEMPOTENCY_TTL_SECONDS=86400
REDIS_KEY_PREFIX=cr

# Rate limits. 0 disables a control. Production uses the owner's numbers (D-RATE-01, see
# deploy/env.production.example); off on a development machine, where tests sign in hundreds of
# times from one address.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=0
AUTH_RATE_LIMIT_WINDOW_SECONDS=0
DOWNLOAD_RATE_LIMIT_MAX=0
DOWNLOAD_RATE_LIMIT_WINDOW_SECONDS=0
REFRESH_RATE_LIMIT_MAX_ATTEMPTS=0
REFRESH_RATE_LIMIT_WINDOW_SECONDS=0
# Link lifetimes, decided by the owner 2026-10-23 (D-AUTH-01): 24 hours, 15 minutes, 3 days.
VERIFICATION_CHALLENGE_TTL_SECONDS=86400
PASSWORD_RECOVERY_TTL_SECONDS=900
ORGANIZATION_INVITATION_TTL_SECONDS=259200

# Public web origin used in links the API builds (verification, Google sign-in return).
WEB_BASE_URL=http://localhost:3000

# Google sign-in (Continue with Google). Leave GOOGLE_CLIENT_ID empty to turn it off.
# Create a "Web application" OAuth client in Google Cloud; use separate clients per environment.
# Never commit real values. The secret stays on the API, never in NEXT_PUBLIC_* variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Next.js (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Bangla QR payment image (owner supplies it; Q-PAY-03). A web path or URL to the image only.
# Showing it confirms nothing: a payment is captured only when finance staff confirm the
# buyer's transaction details (Q-PAY-01, staff verification) or a provider's signed callback.
# Empty = test servers show a marked sample; live servers show "not available yet".
# Use a PNG: buyers can save it from checkout, and phone galleries often can't open an SVG.
BANGLA_QR_IMAGE_URL=
# Shown under the QR so buyers can check who they pay, and pay by number when the code is on the
# phone they pay with. Copy them exactly from the issued code. Empty = not shown.
BANGLA_QR_MERCHANT_NAME=
BANGLA_QR_MERCHANT_NUMBER=
# The app that number belongs to, e.g. bKash.
BANGLA_QR_NUMBER_APP=
# How new payments are taken (Q-PAY-01): sandbox (test payments) or bangla_qr (real payments,
# confirmed by finance staff on Staff > Commerce > Bangla QR payment checks).
PAYMENT_PROVIDER=sandbox

# Email over SMTP (Brevo in production, OD-08). Leave SMTP_HOST empty locally: mail goes to the
# dev mailbox (var/dev-mailbox). Production values: deploy/env.production.example.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Corner Room <no-reply@cornerroom.live>
